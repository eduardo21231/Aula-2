programa {
  funcao inicio() {
        inteiro A = 5
        inteiro B = 8
        inteiro C = 12
        logico D = verdadeiro

        escreva((A + B > C) e (D == verdadeiro), "\n")
        escreva((C - A == B) ou (B > C), "\n")
        escreva(nao (A * 2 > B) e (C > A + B), "\n")
        escreva((B % 2 == 0) e (D ou C == 6), "\n")
  }
}
